{
  "name": "backend",
  "version": "1.0.0",
  "description": "Modliq Backend API Service",
  "main": "dist/entrypoint/server.js",
  "scripts": {
    "dev": "nodemon --exec \"ts-node -r tsconfig-paths/register src/entrypoint/server.ts\"",
    "build": "prisma generate --schema=src/db/prisma/schema.prisma && tsc",
    "start": "node dist/entrypoint/server.js",
    "prisma:generate": "prisma generate --schema=src/db/prisma/schema.prisma",
    "seed:admin": "ts-node src/scripts/seedAdmin.ts",
    "backfill:public-ids": "ts-node src/scripts/backfillPublicIds.ts"
  },
  "prisma": {
    "schema": "src/db/prisma/schema.prisma"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "axios": "^1.16.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.8.0",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "ioredis": "^5.4.1",
    "jsonwebtoken": "^9.0.3",
    "mongodb": "^7.5.0",
    "multer": "^2.1.1",
    "nodemon": "^3.1.14",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prisma": "^5.22.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5",
    "xlsx": "^0.18.5",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "tsconfig-paths": "^4.2.0"
  }
}
